{
  # Lab: HTTP on :80. For HTTPS lab, enable auto_https and trust Caddy local CA on agents.
  auto_https off
}

:80 {
  # Public agent plane (Internet and/or VPN). App-level agent_secret auth is mandatory.
  handle /api/v1/agent/* {
    reverse_proxy control-api:8080
  }

  handle /hubs/agent* {
    reverse_proxy control-api:8080
  }

  handle /health {
    reverse_proxy control-api:8080
  }

  # Admin / Swagger — restrict in production (see Caddyfile.production-snippet). Lab leaves open.
  handle /swagger* {
    reverse_proxy control-api:8080
  }

  handle /api/v1/admin* {
    reverse_proxy control-api:8080
  }

  # React admin console (horizon-control-web)
  handle {
    reverse_proxy web:80
  }
}
