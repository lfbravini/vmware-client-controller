FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props ./
COPY src/HorizonControl.Shared ./HorizonControl.Shared/
COPY src/HorizonControl.Api ./HorizonControl.Api/
RUN dotnet restore HorizonControl.Api/HorizonControl.Api.csproj
RUN dotnet publish HorizonControl.Api/HorizonControl.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "HorizonControl.Api.dll"]
