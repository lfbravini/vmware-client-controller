# Multi-stage: build React admin, serve with nginx
FROM node:20-alpine AS build
WORKDIR /src
COPY src/HorizonControl.Web/package.json src/HorizonControl.Web/package-lock.json* ./
RUN npm install
COPY src/HorizonControl.Web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
